{
  "name": "@soffits/dsh-media-hub",
  "version": "0.17.0",
  "description": "A media hub for DeepSeek Harness: search shows, novels, ebooks and papers across sources, watch together in sync, and download books in the format you want onto your own shelf.",
  "type": "module",
  "license": "MIT",
  "author": "Sakina",
  "repository": {
    "type": "git",
    "url": "https://github.com/soffits/dsh-media-hub.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "watch-together",
    "video",
    "sync",
    "ebooks",
    "epub",
    "novels",
    "books"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tools": "./dist/tools.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "web/*.js",
    "web/*.css",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dist/*",
    "src/sync.js",
    "src/formats.js",
    "src/i18n.js",
    "src/captions.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@soffits/dsh-ui-actions",
        "@soffits/dsh-ui-kit",
        "@soffits/dsh-points",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "for f in index.js tools.js client.js scripts/*.mjs src/*.js src/sources/*.js web/*.js test/*.js test/fixtures/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --import ./test/fixtures/web-modules.mjs --test test/*.test.js",
    "test:browsers": "node scripts/build.mjs && node test/browsers/run.js",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@soffits/dsh-host-kit": "^0.1.0",
    "@soffits/dsh-ui-kit": "0.5.1",
    "danmaku": "^2.0.10",
    "esbuild": "^0.28.2",
    "hls.js": "^1.7.4",
    "https-proxy-agent": "^9.1.0",
    "playwright-core": "^1.65.1",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.23.0"
  }
}
